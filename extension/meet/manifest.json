{
  "manifest_version": 3,
  "name": "TipTop Kraken: Meet names",
  "version": "0.1.0",
  "description": "Lets TipTop Kraken put Google Meet participant names on transcript lines, only while a consented recording runs.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TipTop Kraken: Meet names",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["roster-core.js", "content-meet.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://copilot.tiptop.vc/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content-copilot.js"],
      "run_at": "document_start"
    }
  ]
}
