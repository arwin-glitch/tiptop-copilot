{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TipTop Copilot",
  "version": "0.4.2",
  "identifier": "vc.tiptop.copilot",
  "build": { "frontendDist": "../fallback" },
  "app": { "windows": [], "withGlobalTauri": false, "security": { "csp": null } },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "TipTop Ventures",
    "copyright": "TipTop Ventures",
    "category": "Productivity",
    "shortDescription": "TipTop Copilot",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "13.0" },
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2OTVGMjBGNDBFQzk1OTQKUldTVWxleEFEL0tWWnNoMFlISjNvbFFzWC9yTGFHekVzYzFBb2RGUlZ2SHltUmdJcmJZYVd5VUkK",
      "endpoints": [
        "https://copilot.tiptop.vc/api/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
