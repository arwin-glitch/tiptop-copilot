# TipTop Copilot — environment template
#
# Copy to `.env.local` and fill in. Nothing here is a real value.
#
# The app never throws at import time on a missing variable: it degrades the
# affected capability and reports exactly what is absent at /diagnostics.
# Start there when something is not working.
#
# Full prose for every variable: ENVIRONMENT_VARIABLES.md


# ─────────────────────────────────────────────────────────────────────────────
# Demo mode
# ─────────────────────────────────────────────────────────────────────────────

# With this on, no credential below is needed and no external call is made:
# a file-backed store, a deterministic offline model and fixture mail/calendar
# are used instead. Every company, person and number is fictional.
# MUST be false or unset in a real deployment.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Where the demo store writes its JSON. Relative paths are from the repo root.
DEMO_DATA_DIR=.demo-data


# ─────────────────────────────────────────────────────────────────────────────
# Core — required before deploying
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the deployment. Used to build the OAuth redirect URI.
APP_URL=http://localhost:3000

# Signs the session cookie. At least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In demo mode an ephemeral key is substituted, so sessions drop on restart;
# set this even for a demo you want to survive a redeploy.
SESSION_SECRET=

# Encrypts stored Google refresh/access tokens (AES-256-GCM). Must decode to
# exactly 32 bytes of base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates stored tokens; users reconnect Google. Never
# rotate it without reading SECURITY.md first.
APP_ENCRYPTION_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Supabase — database, auth and file storage
# SUPABASE_SETUP.md walks through creating these.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security, so it must never reach the browser
# and must never be given a NEXT_PUBLIC_ name. Used for storage signing and
# scheduled jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Private bucket holding deal attachments and uploaded documents. Created by
# the migrations; override only if you renamed it.
SUPABASE_STORAGE_BUCKET=deal-attachments


# ─────────────────────────────────────────────────────────────────────────────
# Anthropic
# ─────────────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=

# Model ids come from here and nowhere else — never hard-coded at a call site.
# Fast tier: classification and extraction. Deep tier: analysis, outlook,
# chat, drafts, comparison.
AI_MODEL_FAST=claude-haiku-4-5
AI_MODEL_DEEP=claude-opus-5

# Effort for the deep tier: low | medium | high | xhigh | max.
# Only sent to models that support it; the fast tier never receives it.
AI_EFFORT_DEEP=high


# ─────────────────────────────────────────────────────────────────────────────
# Google Workspace — Gmail and Calendar, read-only
# GOOGLE_OAUTH_SETUP.md walks through creating these.
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated email domains permitted to SIGN IN, e.g. tiptop.vc
#
# Leaving this empty means no restriction, and that is more consequential than
# it sounds: the database provisions an organization with owner role for every
# new user, so an unrestricted deployment hands a working workspace to anyone
# who completes Google sign-in. Set it before the URL reaches anybody.
# Sign-in is Supabase Auth; the callback is ${APP_URL}/api/auth/callback and
# must be registered as a redirect URL in the Supabase dashboard.
AUTH_ALLOWED_EMAIL_DOMAINS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Defaults to ${APP_URL}/api/integrations/google/callback. Set explicitly only
# if it must differ. Whatever is used here must match the Google console
# exactly, including the scheme and any trailing path.
GOOGLE_REDIRECT_URI=

# Scopes are read-only and fixed in code: gmail.readonly, calendar.readonly,
# userinfo.email. There is no send scope, and no way to add one through
# configuration.


# ─────────────────────────────────────────────────────────────────────────────
# Public web research — optional
# ─────────────────────────────────────────────────────────────────────────────

# none | anthropic | custom. Left at `none`, the product says research is
# unavailable rather than answering from the model's memory. That is a
# deliberate default: recalled facts with no retrieval date are worse than a
# stated gap.
RESEARCH_PROVIDER=none

# Only for RESEARCH_PROVIDER=custom.
RESEARCH_API_URL=
RESEARCH_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Scheduled jobs — optional
# ─────────────────────────────────────────────────────────────────────────────

# Bearer token required by /api/cron/daily. Unset, the endpoint rejects every
# caller, which is the safe default.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# Cost and volume ceilings — all optional, all have defaults
#
# These are environment ceilings. Per-organization settings may lower them,
# never raise them.
# ─────────────────────────────────────────────────────────────────────────────

# Messages fetched in one sync run.
MAX_EMAILS_PER_SYNC=250

# How far back a sync reaches when no cursor exists.
DEFAULT_LOOKBACK_DAYS=14

# Attachments read per deal analysis.
MAX_ATTACHMENTS_PER_ANALYSIS=5

# Largest attachment that will be extracted, in bytes (default 25 MB).
MAX_ATTACHMENT_BYTES=26214400

# Pages read from one document before extraction is truncated (and says so).
MAX_ATTACHMENT_PAGES=80

# Characters kept from one document.
MAX_DOCUMENT_CHARS=400000

# Per-user hourly ceiling on AI requests. Enforced against persisted usage
# rows, so it holds across instances.
MAX_AI_REQUESTS_PER_USER_PER_HOUR=120

# Per-organization daily spend ceiling, USD. Reaching it returns a typed
# refusal; stored analyses, search and every non-AI screen keep working.
DAILY_AI_BUDGET_USD=25

# Classify and extract automatically as mail arrives.
AUTO_ANALYZE_ENABLED=true

# Fetch full bodies and attachments during a routine sync rather than only on
# open. Off by default: it materially increases what is stored.
DEEP_AUTO_ANALYSIS=false
